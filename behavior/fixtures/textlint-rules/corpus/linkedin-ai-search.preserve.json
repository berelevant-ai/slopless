      "line": 507
    },
    {
      "text": "The timing sticks.",
      "family": "semantic-thinness",
      "bucket": "hits",
      "source": "cases/semantic-thinness/hits.md",
      "line": 509
    },
    {
      "text": "We didn't rewrite the page. We did, though, change the heading.",
      "family": "syntactic-patterns",
