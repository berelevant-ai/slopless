{
  "id": "vague-threshold-change",
  "class": "threshold-change",
  "purpose": "Catch vague threshold or evaluation changes without named scale, cause, or concrete state.",
  "templates": [
    "{genericSubject} {thresholdVerb} {evaluativeComplement}.",
    "{genericSubject} {thresholdVerb} {comparativeComplement}.",
    "{genericSubject} {feelingVerb} {evaluativeComplement}.",
    "{genericSubject} {thresholdVerb} {weakDegree} {evaluativeComplement}.",
    {
      "text": "{effortAux} more {effortNoun} to {findVerb}",
      "matchMode": "contains"
    },
    {
      "text": "{effortAux} {comparativeEffort} to {findVerb}",
      "matchMode": "contains"
    }
  ],
  "slots": {
    "genericSubject": [
      "things",
      "everything",
      "something",
      "it",
      "this",
      "that",
      "the work",
      "the process",
      "the conversation",
      "the situation",
      "the day",
      "the moment",
      "the path",
      "the choice",
      "the problem",
      "the fix",
      "the report",
      "the spreadsheet",
      "the decision",
      "the decisions",
      "the audit",
      "the strategy",
      "the plan",
      "the content",
      "the page",
      "the post",
      "the source",
      "the signal",
      "the surface",
      "the question"
    ],
    "thresholdVerb": [
      "got",
      "became",
      "grew",
      "turned",
      "seemed",
      "stayed",
      "remained",
      "get",
      "gets"
    ],
    "feelingVerb": [
      "feels",
      "felt",
      "looks",
      "looked",
      "sounds",
      "sounded",
      "seems",
      "seemed"
    ],
    "evaluativeComplement": [
      "different",
      "better",
      "worse",
      "harder",
      "easier",
      "clearer",
      "messier",
      "heavier",
      "lighter",
      "stranger",
      "simpler",
      "complicated",
      "possible",
      "real",
      "precise",
      "thin",
      "useful",
      "useless",
      "weak",
      "strong",
      "expensive",
      "generic",
      "specific"
    ],
    "comparativeComplement": [
      "more real",
      "more possible",
      "more complicated",
      "less certain",
      "less simple",
      "harder to ignore",
      "easier to see",
      "clearer than before"
    ],
    "weakDegree": [
      "a little",
      "somewhat",
      "kind of",
      "more",
      "less",
      "slightly",
      "quietly"
    ],
    "effortAux": [
      "can take",
      "takes",
      "took",
      "will take",
      "would take",
      "tends to take",
      "may take",
      "might take",
      "is",
      "was",
      "are",
      "were",
      "can be",
      "tends to be"
    ],
    "effortNoun": [
      "work",
      "time",
      "effort",
      "digging",
      "patience",
      "care",
      "thought",
      "attention"
    ],
    "comparativeEffort": [
      "harder",
      "tougher",
      "trickier",
      "slower",
      "easier",
      "quicker",
      "simpler"
    ],
    "findVerb": [
      "find",
      "spot",
      "see",
      "fix",
      "diagnose",
      "notice",
      "uncover",
      "reach",
      "get to",
      "get right",
      "pin down",
      "untangle"
    ]
  },
  "rejectIf": [
    "sentence names the scale or metric that changed",
    "sentence names a concrete cause",
    "sentence includes a concrete before or after state",
    "sentence includes a number, date, named actor, or specific event"
  ],
  "positiveExamples": [
    "Things got harder.",
    "Everything became clearer.",
    "Something felt different.",
    "The work became more complicated.",
    "The situation got worse.",
    "It felt more real.",
    "The problem holding a site back can take more work to find.",
    "The real issue is harder to spot."
  ],
  "negativeExamples": [
    "The build got slower after the cache key changed.",
    "Everything became clearer when the audit log showed the missing request.",
    "The situation got worse after three nurses called in sick.",
    "The work became more complicated because the API added pagination.",
    "The leak took two days to find because the meter only logs hourly.",
    "The bug is harder to spot when the cache is warm, so clear it first."
  ],
  "notes": [
    "This pattern must reject concrete cause and metric information.",
    "It is similar to empty scene transition but centered on evaluation thresholds."
  ]
}
