{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "textSha256", "source", "labels"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "textSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "split": { "enum": ["development", "holdout"] },
    "instructions": { "type": "string", "minLength": 1 },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start", "end"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "originalPath", "commit"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "originalPath": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "prompt": { "type": ["string", "null"] },
        "license": { "type": "string", "minLength": 1 },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "labels": { "type": "array" }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 1 } } },
      "then": {
        "properties": {
          "labels": {
            "type": "array",
            "items": { "$ref": "#/definitions/legacyLabel" }
          }
        }
      },
      "else": {
        "required": ["samples", "split"],
        "properties": {
          "samples": { "type": "array" },
          "split": { "type": "string" },
          "labels": {
            "type": "array",
            "items": { "$ref": "#/definitions/minimalLabel" }
          }
        }
      }
    }
  ],
  "definitions": {
    "legacyLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "end",
        "check",
        "expected",
        "reason",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "check": { "type": "string", "minLength": 1 },
        "group": { "type": "string", "minLength": 1 },
        "expected": {
          "anyOf": [
            { "type": ["boolean", "number", "string"] },
            { "type": "array", "items": { "type": "number" }, "minItems": 1 }
          ]
        },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "coverage": { "type": "object" },
        "original": { "type": "object" },
        "review": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "comment"],
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "comment": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "minimalLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "check", "expected"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "check": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "expected": { "type": "boolean" },
        "snippets": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "if": { "properties": { "expected": { "const": true } } },
      "then": { "properties": { "snippets": {} }, "required": ["snippets"] },
      "else": { "properties": { "snippets": false } }
    }
  }
}
