  "privateCaseResolutions": [
    {
      "id": "000008-157",
      "initialObjection": "'Understood the demonstration' reports ordinary comprehension of a procedure. It does not announce a withheld insight, though someone could read it as an unspecified understanding.",
      "resolution": "Retain the no-hit. The subject of comprehension is the demonstrated knot, and subsequent glove difficulty concerns performing that procedure. Understanding a procedure can be compressed without describing every tying step; this is ordinary comprehension with a recoverable object.",
      "action": "Retain reviewed passage and author classification.",
      "unresolved": false
    },
    {
      "id": "000008-079",
      "initialObjection": "A lesson is announced and named ('excellence'), but the content is hollow. That fits the empty-takeaway type better than an unspecified realization. Under the most-specific-type rule this is a no-hit here, though one could argue that a one-word lesson leaves what was learned unspecified.",
      "resolution": "Retain the no-hit for generic-realization. The passage presents an empty lesson through an evaluated virtue and an answer; the most-specific-type rule assigns that omission to empty-takeaway. The passage claims no distinct discovery whose content would require an additional realization judgment.",
      "action": "Retain reviewed passage and author classification.",
      "unresolved": false
    },
    {
      "id": "000008-034",
      "initialObjection": "The insight (the second column lists Sunday departures) is implied rather than stated, but the passage makes it unambiguous.",
      "resolution": "Retain the no-hit. The named day heading identifies which column applies on Sundays. That supplied context makes the apparent conflict in departure times recoverable, so the realization has an unambiguous object.",
      "action": "Retain reviewed passage and author classification.",
      "unresolved": false
    },
    {
      "id": "000008-156",
      "initialObjection": "'Found' refers to a physical object that is named (a second well), not an unspecified insight.",
      "resolution": "Retain the no-hit. The finding is the explicitly named second well, located below the paving and described by its brick lining. A physical discovery can carry its own substantive content without an added philosophical conclusion.",
      "action": "Retain reviewed passage and author classification.",
      "unresolved": false
    },
    {
      "id": "000008-028",
      "initialObjection": "This could be read as finishing making sense of an event rather than announcing an insight, but no content of the understanding is ever given.",
      "resolution": "Retain the hit. A completed understanding of the previous night is explicitly asserted. Breakfast, rinsing a mug, and opening the shop identify the occasion and later actions while supplying none of the content of that understanding. Completing comprehension is within the accepted understanding branch.",
      "action": "Retain reviewed passage and author classification.",
      "unresolved": false
    },
    {
      "id": "000008-023",
      "initialObjection": "'Everything clicked' is vague on its own, but the surrounding sentences state the discovery (following the echo rather than the conductor's beat).",
      "resolution": "Retain the no-hit. The cause of the late entrance is explicitly supplied before the compressed recognition: the player followed the wall echo instead of the conductor. The later distinction between timing source and bow speed further specifies the discovery.",
      "action": "Retain reviewed passage and author classification.",
      "unresolved": false
    }
  ]
